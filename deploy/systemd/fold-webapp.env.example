DEBUG=false
SECRET_KEY=replace-me
ALLOWED_HOSTS=localhost

# Canonical host-run state layout
DATA_DIR=/var/lib/fold-webapp
DATABASE_PATH=/var/lib/fold-webapp/db/db.sqlite3
JOB_BASE_DIR=/var/lib/fold-webapp/jobs
HARNESS_BASE_DIR=/var/lib/fold-webapp/harness

# Current runtime toggle retained until the SLURM control plane is removed
FAKE_SLURM=0
JOB_EXECUTION_BACKEND=slurm
GPU_SLOTS=0

# Model container images
BOLTZ_IMAGE=brineylab/boltz2:latest
CHAI_IMAGE=brineylab/chai1:latest
LIGANDMPNN_IMAGE=brineylab/ligandmpnn:latest
BINDCRAFT_IMAGE=brineylab/bindcraft:latest
RFDIFFUSION3_IMAGE=brineylab/rfdiffusion3:latest
BOLTZGEN_IMAGE=brineylab/boltzgen:latest

# Model cache locations
BOLTZ_CACHE_DIR=/var/lib/fold-webapp/jobs/boltz_cache
CHAI_CACHE_DIR=/var/lib/fold-webapp/jobs/chai_cache
BOLTZGEN_CACHE_DIR=/var/lib/fold-webapp/jobs/boltzgen_cache

# Transitional policy defaults
DEFAULT_MAX_CONCURRENT_JOBS=1
DEFAULT_MAX_QUEUED_JOBS=5
DEFAULT_JOBS_PER_DAY=10
DEFAULT_RETENTION_DAYS=30
