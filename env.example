DEBUG=true
SECRET_KEY=dev-key-change-in-production
ALLOWED_HOSTS=localhost,127.0.0.1

# Root directory for all persistent data (database, jobs, model weight caches).
# Defaults to /opt/fold-webapp/data. Ensure this path exists and is writable by
# the account running docker compose and by the SLURM batch user.
# DATA_DIR=/opt/fold-webapp/data

# Database path. In Docker, this is set automatically via docker-compose.yml.
# Only override if running outside Docker or using a custom location.
# DATABASE_PATH=/path/to/db.sqlite3

# Where job working directories live. Must be writable by the web process and SLURM jobs.
# In Docker, these are set automatically via docker-compose.yml.
# JOB_BASE_DIR=/path/to/jobs
# JOB_BASE_DIR_HOST is the host-side path to the jobs directory. SLURM runs
# on the host, so sbatch scripts must reference host paths, not container paths.
# Auto-set by deploy.sh from DATA_DIR. Override only if your SLURM host path
# differs from your Docker host path.
# JOB_BASE_DIR_HOST=/path/to/jobs

# Enable local/dev mode without SLURM. SLURM job IDs will be FAKE-<job_uuid>.
FAKE_SLURM=0

# Boltz-2 runtime configuration
BOLTZ_IMAGE=brineylab/boltz2:latest
# BOLTZ_CACHE_DIR=$DATA_DIR/jobs/boltz_cache

# Chai-1 runtime configuration
CHAI_IMAGE=brineylab/chai1:latest
# CHAI_CACHE_DIR=$DATA_DIR/jobs/chai_cache

# LigandMPNN runtime configuration
LIGANDMPNN_IMAGE=brineylab/ligandmpnn:latest

# RFdiffusion3 runtime configuration
RFDIFFUSION3_IMAGE=brineylab/rfdiffusion3:latest

# BindCraft runtime configuration
BINDCRAFT_IMAGE=brineylab/bindcraft:latest

# BoltzGen runtime configuration
BOLTZGEN_IMAGE=brineylab/boltzgen:latest
# BOLTZGEN_CACHE_DIR=$DATA_DIR/jobs/boltzgen_cache

# Backup configuration
# BACKUP_DIR=./backups
# BACKUP_RETENTION=30
