DEBUG=true
SECRET_KEY=dev-key-change-in-production
ALLOWED_HOSTS=localhost,127.0.0.1

# Root directory for all persistent data (database, jobs, model weight caches).
# Fresh installs default to $HOME/.fold-webapp/data. Ensure this path exists and
# is writable by the account running the web app and worker. Compose mounts this
# path into the containers at the same absolute location so the local executor's
# direct `docker run -v ...` binds resolve on the host.
# DATA_DIR=$HOME/.fold-webapp/data

# App container runtime uid/gid. deploy.sh auto-sets these to the installing
# user's uid/gid so bind-mounted data stays writable without manual chown.
# APP_UID=1000
# APP_GID=1000

# Database path. In Docker, this is set automatically via docker-compose.yml.
# Only override if running outside Docker or using a custom location.
# DATABASE_PATH=/path/to/db.sqlite3

# Where job working directories live.
# In Docker, these are set automatically via docker-compose.yml.
# JOB_BASE_DIR=/path/to/jobs

# Directory for the post-install model validation harness.
# Defaults to $DATA_DIR/harness.
# HARNESS_BASE_DIR=$DATA_DIR/harness

# Comma-separated host GPU indices used by the worker for direct Docker launches.
GPU_SLOTS=0

# Shared-memory defaults for model containers. Raise the global baseline if
# multiple models start failing with PyTorch/IPC shared-memory allocation
# errors. Prefer per-model overrides before using DOCKER_DEFAULT_IPC_MODE=host.
DOCKER_DEFAULT_SHM_SIZE=8g
# DOCKER_DEFAULT_IPC_MODE=

# Boltz-2 runtime configuration
BOLTZ_IMAGE=brineylab/boltz2:latest
# BOLTZ_CACHE_DIR=$DATA_DIR/jobs/boltz_cache
BOLTZ_DOCKER_SHM_SIZE=16g
# BOLTZ_DOCKER_IPC_MODE=

# Chai-1 runtime configuration
CHAI_IMAGE=brineylab/chai1:latest
# CHAI_CACHE_DIR=$DATA_DIR/jobs/chai_cache
# CHAI_DOCKER_SHM_SIZE=$DOCKER_DEFAULT_SHM_SIZE
# CHAI_DOCKER_IPC_MODE=$DOCKER_DEFAULT_IPC_MODE

# LigandMPNN runtime configuration
LIGANDMPNN_IMAGE=brineylab/ligandmpnn:latest
# LIGANDMPNN_DOCKER_SHM_SIZE=$DOCKER_DEFAULT_SHM_SIZE
# LIGANDMPNN_DOCKER_IPC_MODE=$DOCKER_DEFAULT_IPC_MODE

# RFdiffusion3 runtime configuration
RFDIFFUSION3_IMAGE=brineylab/rfdiffusion3:latest
# RFDIFFUSION3_DOCKER_SHM_SIZE=$DOCKER_DEFAULT_SHM_SIZE
# RFDIFFUSION3_DOCKER_IPC_MODE=$DOCKER_DEFAULT_IPC_MODE

# BindCraft runtime configuration
BINDCRAFT_IMAGE=brineylab/bindcraft:latest
# BINDCRAFT_DOCKER_SHM_SIZE=$DOCKER_DEFAULT_SHM_SIZE
# BINDCRAFT_DOCKER_IPC_MODE=$DOCKER_DEFAULT_IPC_MODE

# BoltzGen runtime configuration
BOLTZGEN_IMAGE=brineylab/boltzgen:latest
# BOLTZGEN_CACHE_DIR=$DATA_DIR/jobs/boltzgen_cache
# BOLTZGEN_DOCKER_SHM_SIZE=$DOCKER_DEFAULT_SHM_SIZE
# BOLTZGEN_DOCKER_IPC_MODE=$DOCKER_DEFAULT_IPC_MODE

# OpenFold3 runtime configuration
OPENFOLD3_IMAGE=brineylab/openfold3:latest
# OPENFOLD3_CACHE_DIR=$DATA_DIR/jobs/openfold3_cache
OPENFOLD3_DOCKER_SHM_SIZE=16g
# OPENFOLD3_DOCKER_IPC_MODE=$DOCKER_DEFAULT_IPC_MODE
